DISCORD_TOKEN=isi_token_bot
DATABASE_URL=postgres://postgres:password@localhost:5432/urbaniac
# Opsional: isi untuk registrasi command instan di satu server (tanpa ini: global, bisa butuh waktu)
# DISCORD_GUILD_ID=123456789012345678
# Maksimal 5 (dibatasi oleh kode)
DB_MAX_CONNECTIONS=5
RUST_LOG=info,urbaniac=debug
# Skala durasi aktivitas (persen). 100 = normal; 5 = 20x lebih cepat untuk testing
ACTIVITY_DURATION_PCT=100

# --- Discord Activity (opsional; default false = hanya menjalankan bot) ---
ACTIVITY_ENABLED=false
ACTIVITY_BIND_ADDR=127.0.0.1:8080
ACTIVITY_STATIC_DIR=./activity-dist
# Wajib diisi hanya jika ACTIVITY_ENABLED=true:
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=isi_client_secret_oauth2
