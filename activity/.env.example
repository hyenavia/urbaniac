# Mode pengembangan lokal di PC tanpa backend/PostgreSQL:
VITE_USE_MOCK_API=true

# Isi Client ID aplikasi Discord (aman di frontend; JANGAN pernah taruh Client Secret di sini!)
VITE_DISCORD_CLIENT_ID=

# Opsional: target proxy /api saat menguji dengan backend dev di laptop
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
